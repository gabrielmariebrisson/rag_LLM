# ============================================
# RAG System - Variables d'Environnement
# ============================================
# Copier ce fichier vers .env et remplir avec vos valeurs
# cp .env.example .env

# ============================================
# Configuration LLM (3 modes possibles)
# ============================================

# Option 1: vLLM Local (Recommandé pour performance)
# Définir LLM_BASE_URL pour utiliser vLLM local
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_MODEL_NAME=TheBloke/Mistral-7B-Instruct-v0.2-AWQ
# LLM_API_KEY=dummy-key  # vLLM accepte n'importe quelle clé

# Option 2: OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL_NAME=gpt-4o-mini

# Option 3: Mistral API (Legacy - déprécié, utiliser OpenAI API ou vLLM)
# Laisser LLM_BASE_URL vide ou non défini
# MISTRAL_API_KEY=your-mistral-api-key-here
# LLM_MODEL_NAME=mistral-tiny-2407

# Configuration par défaut (Mistral API Legacy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=mistral-tiny-2407

# Legacy Mistral API (backward compatibility)
MISTRAL_API_KEY=
MISTRAL_MODEL_NAME=

# ============================================
# Configuration Qdrant
# ============================================

# Host et port de Qdrant (local ou cloud)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Nom de la collection dans Qdrant
# La collection sera créée automatiquement si elle n'existe pas
QDRANT_COLLECTION_NAME=squad_collection

# Pour Qdrant Cloud, utiliser :
# QDRANT_HOST=your-cluster.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-api-key  # Si requis par Qdrant Cloud

# ============================================
# Configuration Reranker
# ============================================

# Activer/désactiver le reranking (recommandé: true)
# Le reranking améliore la précision mais augmente la latence
USE_RERANKER=true

# Nombre de documents à récupérer avant reranking
# Plus élevé = meilleure qualité mais plus lent (défaut: 20)
RERANKER_TOP_K=20

# ============================================
# Modèles d'Embedding
# ============================================

# Modèle Dense (sentence-transformers)
# Modèles recommandés:
# - sentence-transformers/all-MiniLM-L6-v2 (384 dim, rapide)
# - sentence-transformers/all-mpnet-base-v2 (768 dim, meilleure qualité)
DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Modèle Sparse (BERT-based pour embeddings SPLADE-like)
# Modèle standard pour générer des embeddings sparse (keywords)
SPARSE_MODEL=bert-base-uncased

# Modèle Reranker (Cross-Encoder)
# Modèles recommandés:
# - cross-encoder/ms-marco-MiniLM-L-6-v2 (rapide)
# - cross-encoder/ms-marco-MiniLM-L-12-v2 (meilleure qualité)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Embedding Model (Legacy - utilisé pour migration depuis FAISS)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# Configuration Frontend
# ============================================

# URL du backend FastAPI (utilisé par le frontend Streamlit)
BACKEND_URL=http://localhost:8000

# ============================================
# Configuration OpenTelemetry / Jaeger
# ============================================

# Activer/désactiver l'export vers Jaeger
# Si false, les traces seront exportées vers la console uniquement
ENABLE_JAEGER_EXPORT=true

# Endpoint OTLP pour Jaeger (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ============================================
# Configuration Legacy (Migration FAISS)
# ============================================

# Répertoire contenant l'index FAISS (legacy, pour migration)
FAISS_INDEX_DIR=faiss_index

# ============================================
# Notes Importantes
# ============================================
#
# 1. LLM Configuration:
#    - Pour vLLM local: Définir LLM_BASE_URL (ex: http://localhost:8001/v1)
#    - Pour OpenAI API: Définir LLM_BASE_URL=https://api.openai.com/v1 et LLM_API_KEY
#    - Pour Mistral API: Laisser LLM_BASE_URL vide et définir MISTRAL_API_KEY
#
# 2. Qdrant:
#    - Pour développement local: Utiliser localhost:6333
#    - Pour production: Considérer Qdrant Cloud ou cluster Kubernetes
#
# 3. GPU/CUDA:
#    - Les modèles d'embedding et reranker utiliseront GPU automatiquement si disponible
#    - Vérifier avec: python -c "import torch; print(torch.cuda.is_available())"
#
# 4. Performance:
#    - USE_RERANKER=true améliore la qualité mais augmente la latence (~20-50ms)
#    - RERANKER_TOP_K=20 est un bon compromis qualité/vitesse
#
# 5. Jaeger:
#    - Si Docker n'est pas disponible, définir ENABLE_JAEGER_EXPORT=false
#    - Les traces OpenTelemetry restent actives, mais sont exportées vers la console
