# ============================================
# Configuration LLM
# ============================================

# Option 1: vLLM Local (Recommandé pour performance)
LLM_BASE_URL=http://localhost:8001/v1
LLM_MODEL_NAME=casperhansen/llama-3-8b-instruct-awq
LLM_API_KEY=dummy-key  # vLLM accepte n'importe quelle clé

# Option 2: OpenAI API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL_NAME=gpt-4o-mini

# Option 3: Mistral API (Legacy - Déprécié)
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_MODEL_NAME=casperhansen/llama-3-8b-instruct-awq

# ============================================
# HuggingFace Token (pour télécharger les modèles)
# ============================================
# Requis pour télécharger certains modèles depuis HuggingFace Hub
# Obtenez votre token sur https://huggingface.co/settings/tokens
HUGGING_FACE_HUB_TOKEN=your-huggingface-token-here

# ============================================
# Configuration Qdrant
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=squad_collection
# QDRANT_API_KEY=your-qdrant-api-key  # Optionnel pour Qdrant Cloud

# ============================================
# Configuration Embeddings
# ============================================
DENSE_MODEL=BAAI/bge-m3
SPARSE_MODEL=prithivida/Splade_pp_en_v1
DENSE_DIM=1024  # Dimension des embeddings denses (BGE-M3)

# ============================================
# Configuration Reranker
# ============================================
USE_RERANKER=true
RERANKER_TOP_K=100
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============================================
# Configuration OpenTelemetry/Jaeger
# ============================================
ENABLE_JAEGER_EXPORT=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rag-system

# ============================================
# Configuration Frontend
# ============================================
BACKEND_URL=http://localhost:8000

# ============================================
# Variables Legacy (pour compatibilité)
# ============================================
# EMBEDDING_MODEL_NAME=BAAI/bge-m3  # Utiliser DENSE_MODEL à la place
# FAISS_INDEX_DIR=faiss_index  # Utilisé lors de la migration depuis FAISS
