[flake8]
max-line-length = 100
exclude =
    venv,
    __pycache__,
    .git,
    .venv,
    build,
    dist,
    *.egg-info,
    archive,
    data,
    logs
ignore =
    E501,  # Line too long (handled by Black)
    W503,  # Line break before binary operator
    E203,  # Whitespace before ':' (conflict with Black)
per-file-ignores =
    __init__.py:F401  # Unused imports allowed in __init__.py

